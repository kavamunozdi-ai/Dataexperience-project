      "source": [
        "4. Identificacion de outliers, relaciones e hipotesis"
      ],
      "metadata": {
        "id": "bf29EztQ6pUO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Función para identificar valores atípicos mediante el método IQR\n",
        "\n",
        "def identificar_outliers(dataframe, columna):\n",
        "\n",
        "    Q1 = dataframe[columna].quantile(0.25)\n",
        "    Q3 = dataframe[columna].quantile(0.75)\n",
        "\n",
        "    IQR = Q3 - Q1\n",
        "\n",
        "    limite_inferior = Q1 - 1.5 * IQR\n",
        "    limite_superior = Q3 + 1.5 * IQR\n",
        "\n",
        "    outliers = dataframe[\n",
        "        (dataframe[columna] < limite_inferior) |\n",
        "        (dataframe[columna] > limite_superior)\n",
        "    ]\n",
        "\n",
        "    return Q1, Q3, IQR, limite_inferior, limite_superior, outliers"
      ],
      "metadata": {
        "id": "o0Qs2wnU6yiZ"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Identificar outliers en el precio de venta\n",
