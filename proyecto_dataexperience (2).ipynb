        "    'Selling_Price'\n",
        ")\n",
        "\n",
        "print(\"Q1:\", Q1)\n",
        "print(\"Q3:\", Q3)\n",
        "print(\"IQR:\", IQR)\n",
        "print(\"Límite inferior:\", limite_inf)\n",
        "print(\"Límite superior:\", limite_sup)\n",
        "print(\"Cantidad de posibles outliers:\", len(outliers_precio))"
      ],
